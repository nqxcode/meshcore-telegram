# Telegram: замените токен от @BotFather и ID своей группы.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# USB-порт узла MeshCore Companion.
MESH_PORT=/dev/ttyACM0

# Отдельный канал моста на устройстве (индекс должен быть ненулевым).
# Public с индексом 0 доступен через команду бота /channel public.
# В systemd эти параметры также заданы в meshcore-systemd.conf.
MESHCORE_CHANNEL=1
MESHCORE_CHANNEL_NAME='#tulameshbridge'

# Минимальный интервал между попытками отправки в радио, в секундах.
MESH_SEND_INTERVAL=1

# Необязательно: по умолчанию bridge-state.json рядом с bridge.py.
# Укажите абсолютный путь; каталог должен существовать и быть доступен для записи.
# BRIDGE_STATE_FILE=/absolute/path/to/bridge-state.json
